# ─────────────────────────────────────────────────────────────
# 对话式作战台 · 编排服务配置
#
# 用法：把这个文件复制成 console/.env，然后**只填下面两把 key**，其它保持默认即可。
#     cp console/.env.example console/.env
#
# 两把 key 是两回事，别搞混：
#   ① CONSOLE_LLM_API_KEY   —— 模型厂的 key（你上次说的 DeepSeek 就是这把），让作战台"会说话、会编排"
#   ② RECONLAB_WORKER_KEY   —— 控制台「Agent 接入」页里生成的 rlk_ 开头那把，
#                              让编排层能拉队列、回写判定（权限勾 review，最好也勾 ingest）
# key 只放这个文件里，别提交进 git、别贴群里。服务端读进来之后不会回显给浏览器。
# ─────────────────────────────────────────────────────────────

# ── ① 模型侧（OpenAI 兼容接口） ──
CONSOLE_LLM_PROVIDER=deepseek
CONSOLE_LLM_BASE_URL=https://api.deepseek.com/v1
CONSOLE_LLM_API_KEY=                 # ← 你填这里：sk-...（模型 Key）
CONSOLE_LLM_MODEL=deepseek-chat
# 规划 / 冲突消解用强模型；执行、判定这种高频结构化步骤想省钱就换便宜档（留空=跟主模型一样）
CONSOLE_LLM_PLAN_MODEL=
CONSOLE_LLM_FAST_MODEL=
# 思考模式：disabled / low / medium / high / auto。
# Agent 循环里每步都思考又贵又慢，默认关；只在规划阶段想开就把整体调成 low 之类。
CONSOLE_LLM_THINKING=disabled
CONSOLE_LLM_MAX_TOKENS=4096
CONSOLE_LLM_TIMEOUT=180
CONSOLE_LLM_RETRIES=3
# 回写判定走 strict json_schema：模型严格按 schema 出参，解析失败基本绝迹
CONSOLE_LLM_STRICT=true
# 特殊参数直塞（JSON 串），比如某些中转要的额外字段
CONSOLE_LLM_EXTRA_JSON=

# ── ② 后端契约侧 ──
RECONLAB_BASE_URL=http://127.0.0.1:8090
RECONLAB_WORKER_KEY=                 # ← 你填这里：rlk_...（控制台「Agent 接入」生成）
RECONLAB_WORKER_ID=console-01
RECONLAB_LEASE_SECONDS=900
RECONLAB_TIMEOUT=30

# ── ③ 编排策略 ──
CONSOLE_MAX_STEPS=24                 # 一轮最多多少个工具步，超了停手汇报
CONSOLE_MAX_412_RETRY=1              # 412 只重试一次（契约就这么写的），再撞就弃单
CONSOLE_MAX_RUBRIC_RETRY=2           # 判定准则不过最多回炉两次
# 主动探测（编排层自己对目标发 GET/HEAD）：默认关。
# 关着的时候 http_probe 工具压根不会暴露给模型 —— 探测交给执行器和验证器 Agent 去干。
CONSOLE_ALLOW_ACTIVE_PROBE=false

# ── ④ 服务侧 ──
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8091
CONSOLE_DB=console/console.sqlite
